# YouCam API key (yce.makeupar.com → API keys). Without it, skin analysis runs in demo mode.
YOUCAM_API_KEY=
# "1" to use HD concerns (12 units per scan instead of 9).
YOUCAM_HD=
# Optional Anthropic key for reading label photos on the server. Without it, labels are read on the phone (tesseract.js).
ANTHROPIC_API_KEY=
